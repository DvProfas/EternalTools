{
  "manifest_version": 3,
  "name": "Eternal TOOLS v4",
  "version": "4.1.0",
  "description": "Gerenciador premium de contas para Roblox.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Eternal TOOLS v4",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://*.rbxcdn.com/*",
    "https://users.roblox.com/*",
    "https://friends.roblox.com/*",
    "https://auth.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}